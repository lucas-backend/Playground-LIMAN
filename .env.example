# Konfigurasi environment frontend LIMEN.
# Salin menjadi .env untuk pengembangan lokal. Jangan commit file .env.
# Hanya variabel ber-prefix VITE_ yang tersedia di kode klien.

# Base URL API backend (tanpa trailing slash).
# Kosongkan untuk memakai origin yang sama (same-origin).
# Contoh: http://localhost:8080/api/v1
VITE_API_BASE_URL=
